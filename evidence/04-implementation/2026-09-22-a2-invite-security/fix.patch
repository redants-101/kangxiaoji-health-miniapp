+    expiresAt: new Date(Date.now() + 3600 * 1000).toISOString(),
+    ...overrides
+  }
+}
+
+function attemptRows(db) { return db._stores[COLLECTIONS.inviteAttempts].rows }
+function memberRows(db) { return db._stores[COLLECTIONS.familyMembers].rows }
