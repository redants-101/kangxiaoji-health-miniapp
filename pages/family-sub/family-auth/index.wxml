<block wx:if="{{isLoading}}">
  <view class="page-state {{adaptive.scaleClass}}">
    <view class="state-panel">
      <view class="state-title">正在加载家属权限</view>
      <view class="state-meta">可查看范围、提醒规则和最近查看记录会在加载后展示。</view>
    </view>
  </view>
</block>
<block wx:elif="{{loadError}}">
  <view class="page-state {{adaptive.scaleClass}}">
    <view class="state-panel">
      <view class="state-title">家属权限加载失败</view>
      <view class="state-meta">{{loadError}}</view>
      <button class="state-button" bindtap="reloadPage">重新加载</button>
    </view>
  </view>
</block>
<block wx:else>
  <view class="auth-page {{adaptive.scaleClass}} {{adaptive.layoutClass}}">
  <view class="member-panel">
    <view class="member-row">
      <view class="avatar">女</view>
      <view class="member-main">
        <view class="member-name">{{member.name}}</view>
        <view class="member-meta">{{member.relation}} · {{member.role}}</view>
      </view>
      <view class="member-status">{{member.status}}</view>
    </view>
    <view class="member-desc">{{member.desc}}</view>
  </view>

  <view class="section">
    <view class="section-title">可查看内容</view>
    <view class="scope-panel">
      <view wx:for="{{scopes}}" wx:key="key" class="scope-block">
        <view class="row-main">
          <view class="scope-title">{{item.title}}</view>
          <view class="scope-meta">{{item.meta}}</view>
        </view>
        <view class="scope-switches">
          <view class="switch-cell">
            <text class="switch-label">查看</text>
            <switch checked="{{item.read}}" color="#168957" data-key="{{item.key}}" data-field="read" bindchange="toggleScope" />
          </view>
          <view wx:if="{{item.key !== 'report'}}" class="switch-cell">
            <text class="switch-label">代录</text>
            <switch checked="{{item.write}}" color="#168957" data-key="{{item.key}}" data-field="write" bindchange="toggleScope" />
          </view>
          <view class="switch-cell">
            <text class="switch-label">提醒</text>
            <switch checked="{{item.remind}}" color="#168957" data-key="{{item.key}}" data-field="remind" bindchange="toggleScope" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">提醒给家属</view>
    <view class="scope-panel">
      <view wx:for="{{noticeRuleItems}}" wx:key="key" class="scope-row">
        <view class="row-main">
          <view class="scope-title">{{item.title}}</view>
          <view class="scope-meta">{{item.meta}}</view>
        </view>
        <switch checked="{{item.checked}}" color="#168957" data-key="{{item.key}}" bindchange="toggleNoticeRule" />
      </view>
    </view>
  </view>

  <!-- A6 提醒电话：owner 家庭授权配置；家属在"提醒"开启时看到脱敏号并可拨打 -->
  <view class="section">
    <view class="section-title">提醒电话</view>
    <view class="scope-panel">
      <view class="phone-desc">开启上方任一"提醒"权限后，家属可看到脱敏号码{{contactPhoneMasked ? '（当前：' + contactPhoneMasked + '）' : ''}}并一键拨打；系统拨号盘会显示完整号码。号码仅用于健康提醒联系，可随时修改或清空，关闭提醒或解除授权后家属立即无法再获取。</view>
      <input class="phone-input" type="number" maxlength="11" value="{{contactPhoneInput}}" placeholder="填写11位手机号，用于提醒" bindinput="handlePhoneInput" />
      <view wx:if="{{contactPhoneError}}" class="phone-error">{{contactPhoneError}}</view>
      <view class="phone-actions">
        <button class="phone-save" loading="{{savingPhone}}" disabled="{{savingPhone}}" bindtap="saveContactPhone">保存电话</button>
        <button class="phone-clear" disabled="{{!contactPhone || savingPhone}}" bindtap="clearContactPhone">清空</button>
      </view>
    </view>
  </view>

  <view class="section">
    <notice-bar text="家属只能看到你授权的记录和提醒状态。康小记不提供诊断、治疗或处方建议。" />
  </view>

  <fixed-action text="保存权限" disabled="{{!canEdit}}" loading="{{pendingAction === 'save'}}" bindactiontap="saveAuth" />
  </view>
</block>
