.auth-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 150rpx;
  background: #f8faf8;
}

.member-panel {
  padding: 30rpx;
  border-radius: 16rpx;
  border: 1rpx solid #cbe5d6;
  background: #ecf7f0;
}

.member-row,
.scope-row {
  display: flex;
  align-items: center;
}

.member-row,
.scope-row {
  justify-content: space-between;
  gap: 24rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #168957;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.member-main,
.row-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  color: #14201a;
  font-size: 36rpx;
  font-weight: 900;
}

.member-meta,
.member-desc,
.scope-meta,
.activity-meta {
  color: #65756d;
  font-size: 25rpx;
  line-height: 1.45;
}

.member-meta {
  margin-top: 8rpx;
}

.member-status {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #b4dec7;
  color: #0e6f45;
  font-size: 24rpx;
  font-weight: 800;
}

.member-desc {
  margin-top: 22rpx;
  color: #4f6258;
}

.section {
  margin-top: 36rpx;
}

.scope-panel {
  margin-top: 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid #dfe7e1;
  background: #ffffff;
  overflow: hidden;
}

.scope-row {
  min-height: 116rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #dfe7e1;
}

.scope-row:last-child {
  border-bottom: 0;
}

.scope-title {
  color: #14201a;
  font-size: 30rpx;
  font-weight: 850;
}

.scope-meta {
  margin-top: 8rpx;
}

.scope-block {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2ee;
}

.scope-block:last-child {
  border-bottom: none;
}

.scope-switches {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
}

.switch-cell {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.switch-label {
  font-size: 24rpx;
  color: #5c6b60;
}

/* A6 提醒电话 */
.phone-desc {
  color: #65756d;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.phone-input {
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8e6de;
  border-radius: 12rpx;
  background: #fff;
  font-size: 28rpx;
}

.phone-error {
  margin-top: 10rpx;
  color: #c8463a;
  font-size: 24rpx;
}

.phone-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.phone-save {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #168957;
  color: #fff;
  font-size: 28rpx;
}

.phone-clear {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 36rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid #efc3bf;
  background: #fff7f6;
  color: #c8463a;
  font-size: 28rpx;
  font-weight: 800;
}

/* 覆盖原生/全局 button[disabled] 的灰底灰字，禁用态保留危险色 */
.phone-clear[disabled] {
  background: #fff7f6;
  border-color: #efc3bf;
  color: #c8463a;
  opacity: 1;
}
